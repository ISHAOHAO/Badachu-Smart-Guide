.page {
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.header {
  position: relative;
  padding: 60rpx 32rpx 40rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, var(--color-brown-dark), var(--color-brown), var(--color-gold-dark));
  border-radius: 0 0 40rpx 40rpx;
  opacity: 0.95;
}

.header-content {
  position: relative;
  z-index: 1;
}

.app-title {
  display: block;
  font-size: var(--font-xxl);
  font-weight: 700;
  color: var(--color-gold-light);
  margin-bottom: 8rpx;
}

.app-subtitle {
  display: block;
  font-size: var(--font-sm);
  color: rgba(255,255,255,0.7);
  margin-bottom: 24rpx;
}

.fortune-bar {
  display: inline-flex;
  align-items: center;
  background: rgba(255,255,255,0.15);
  padding: 12rpx 24rpx;
  border-radius: var(--radius-full);
  backdrop-filter: blur(10px);
}

.fortune-label {
  font-size: var(--font-sm);
  color: var(--color-gold-light);
  margin-right: 12rpx;
}

.fortune-value {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-gold);
}

.age-selector {
  padding: 16rpx 32rpx;
}

.age-tabs {
  display: flex;
  background: var(--color-gray-5);
  border-radius: var(--radius-lg);
  padding: 6rpx;
}

.age-tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: var(--font-xs);
  color: var(--text-secondary);
  border-radius: var(--radius-md);
  transition: all 0.3s;
}

.age-tab.active {
  background: var(--color-gold);
  color: var(--color-white);
  font-weight: 600;
}

.quick-actions {
  display: flex;
  padding: 16rpx 32rpx;
  gap: 16rpx;
}

.action-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--bg-card);
  padding: 24rpx 16rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.action-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.action-label {
  font-size: var(--font-xs);
  color: var(--text-primary);
  font-weight: 500;
}

.section {
  padding: 16rpx 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--text-primary);
}

.section-more {
  font-size: var(--font-sm);
  color: var(--color-gold);
}

.spots-scroll {
  white-space: nowrap;
  padding-bottom: 16rpx;
}

.spot-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 180rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 24rpx 16rpx;
  margin-right: 20rpx;
  box-shadow: var(--shadow-sm);
  white-space: normal;
}

.spot-card-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.spot-card-order {
  font-size: var(--font-xs);
  color: var(--color-gold);
  margin-bottom: 4rpx;
}

.spot-card-name {
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.spot-card-subtitle {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  text-align: center;
}

.discovery-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.discovery-item {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  box-shadow: var(--shadow-sm);
}

.discovery-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.discovery-name {
  display: block;
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.discovery-desc {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-tertiary);
}

.nearby-hint {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, rgba(212,168,75,0.1), rgba(212,168,75,0.05));
  border: 2rpx solid var(--color-gold);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  animation: goldenGlow 2s ease-in-out infinite;
}

.hint-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
  animation: pulse 2s ease-in-out infinite;
}

.hint-content {
  flex: 1;
}

.hint-title {
  display: block;
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--color-brown);
  margin-bottom: 4rpx;
}

.hint-desc {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-tertiary);
}

.hint-arrow {
  font-size: 36rpx;
  color: var(--color-gold);
}

.footer-section {
  padding-top: 32rpx;
}

.footer-info {
  text-align: center;
  padding: 32rpx 0;
}

.footer-text {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-tertiary);
  margin-bottom: 4rpx;
}

.footer-copyright {
  display: block;
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  margin-top: 16rpx;
}