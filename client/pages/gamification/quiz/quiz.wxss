.page { padding: 20rpx; background: #FDF5E6; min-height: 100vh; }
.header { text-align: center; padding: 30rpx 0 10rpx; }
.title { font-size: 38rpx; font-weight: bold; color: #5D4037; }
.subtitle { font-size: 24rpx; color: #8B7355; display: block; margin-top: 6rpx; }
.stats-card { background: #fff; border-radius: 16rpx; padding: 30rpx; margin: 30rpx 0; text-align: center; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05); }
.stats-title { font-size: 28rpx; color: #5D4037; font-weight: bold; }
.stats-row { flex-direction: row; justify-content: space-around; display: flex; margin-top: 24rpx; }
.stat-item { text-align: center; }
.stat-num { font-size: 48rpx; font-weight: bold; display: block; }
.stat-num.green { color: #27ae60; }
.stat-num.red { color: #C0392B; }
.stat-num.gold { color: #D4A84B; }
.stat-label { font-size: 24rpx; color: #8B7355; margin-top: 6rpx; display: block; }
.start-btn { width: 70%; margin: 40rpx auto; background: linear-gradient(135deg, #D4A84B, #C0392B); color: #fff; text-align: center; padding: 24rpx 0; border-radius: 50rpx; font-size: 32rpx; font-weight: bold; }

.quiz-header { flex-direction: row; align-items: center; display: flex; margin: 20rpx 0; }
.quiz-progress { font-size: 26rpx; color: #5D4037; margin-right: 16rpx; white-space: nowrap; }
.quiz-progress-bar { flex: 1; height: 10rpx; background: #f0e8d8; border-radius: 5rpx; overflow: hidden; }
.quiz-progress-fill { height: 100%; background: linear-gradient(90deg, #D4A84B, #C0392B); border-radius: 5rpx; }
.tag { display: inline-block; background: #f0e8d8; color: #5D4037; padding: 6rpx 20rpx; border-radius: 20rpx; font-size: 22rpx; margin: 16rpx 0; }
.question { font-size: 32rpx; color: #5D4037; line-height: 1.6; margin: 20rpx 0 30rpx; }

.options { }
.option { flex-direction: row; align-items: center; display: flex; background: #fff; padding: 24rpx; border-radius: 14rpx; margin-bottom: 16rpx; border: 2rpx solid transparent; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.option.correct { border-color: #27ae60; background: #eafaf1; }
.option.wrong { border-color: #C0392B; background: #fdedec; }
.option-letter { width: 44rpx; height: 44rpx; border-radius: 50%; background: #f0e8d8; text-align: center; line-height: 44rpx; font-size: 24rpx; color: #5D4037; margin-right: 16rpx; flex-shrink: 0; }
.option.correct .option-letter { background: #27ae60; color: #fff; }
.option.wrong .option-letter { background: #C0392B; color: #fff; }
.option-text { font-size: 28rpx; color: #5D4037; flex: 1; }

.feedback { margin-top: 20rpx; }
.feedback-icon { font-size: 30rpx; font-weight: bold; display: block; }
.feedback-icon.correct { color: #27ae60; }
.feedback-icon.wrong { color: #C0392B; }
.feedback-desc { font-size: 26rpx; color: #8B7355; margin: 12rpx 0 24rpx; line-height: 1.6; }
.next-btn { background: #D4A84B; color: #fff; text-align: center; padding: 20rpx 0; border-radius: 12rpx; font-size: 28rpx; margin-top: 10rpx; }

.result { text-align: center; padding: 60rpx 0; }
.result-title { font-size: 40rpx; font-weight: bold; color: #5D4037; }
.result-score { font-size: 32rpx; color: #8B7355; margin: 16rpx 0; display: block; }
.result-points { font-size: 28rpx; color: #D4A84B; font-weight: bold; display: block; margin-bottom: 40rpx; }
.result-btn { width: 60%; margin: 16rpx auto; background: linear-gradient(135deg, #D4A84B, #C0392B); color: #fff; text-align: center; padding: 22rpx 0; border-radius: 50rpx; font-size: 30rpx; }
.result-btn.secondary { background: #f0e8d8; color: #5D4037; }
