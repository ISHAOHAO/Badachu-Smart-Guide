.page {
  min-height: 100vh;
  background: #FDF5E6;
  padding: 30rpx;
}
.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #5D4037;
  text-align: center;
  margin-bottom: 24rpx;
}
.progress-bar {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.progress-text {
  font-size: 24rpx;
  color: #5D4037;
  display: block;
  margin-bottom: 12rpx;
}
.progress-track {
  height: 16rpx;
  background: #f0e8d8;
  border-radius: 8rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #D4A84B, #C0392B);
  border-radius: 8rpx;
  transition: width 0.3s;
}
.tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.tab {
  background: #fff;
  padding: 14rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #5D4037;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  display: flex;
  align-items: center;
}
.tab.active {
  background: #D4A84B;
  color: #fff;
}
.tab-count {
  font-size: 20rpx;
  margin-left: 4rpx;
  opacity: 0.8;
}
.badge-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.badge-item {
  width: calc(33.33% - 14rpx);
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 0;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.badge-item.locked {
  opacity: 0.5;
  background: #f5f0e8;
}
.badge-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}
.badge-name {
  font-size: 22rpx;
  color: #5D4037;
}
.modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.modal-content {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx;
  width: 560rpx;
  text-align: center;
}
.modal-icon { font-size: 100rpx; margin-bottom: 20rpx; }
.modal-name { font-size: 32rpx; font-weight: bold; color: #5D4037; margin-bottom: 16rpx; }
.modal-info { font-size: 24rpx; color: #888; margin-bottom: 10rpx; }
.modal-close {
  margin-top: 30rpx;
  background: #D4A84B;
  color: #fff;
  padding: 16rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
}
