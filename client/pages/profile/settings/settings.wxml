<view class="page">
  <view class="header">
    <text class="title">设置</text>
  </view>

  <view class="section">
    <view class="setting-item">
      <text class="setting-label">禅音开关</text>
      <switch checked="{{chanYin}}" color="#D4A84B" bindchange="onToggleChanYin" />
    </view>
    <view class="setting-item">
      <text class="setting-label">通知设置</text>
      <switch checked="{{notification}}" color="#D4A84B" bindchange="onToggleNotification" />
    </view>
  </view>

  <view class="section-title">偏好设置</view>
  <view class="section">
    <view class="setting-item">
      <text class="setting-label">多语言</text>
      <view class="setting-options">
        <view class="option-btn {{lang === 'zh' ? 'active' : ''}}" bindtap="onSetLang" data-lang="zh">中文</view>
        <view class="option-btn {{lang === 'en' ? 'active' : ''}}" bindtap="onSetLang" data-lang="en">English</view>
      </view>
    </view>
    <view class="setting-item">
      <text class="setting-label">字体大小</text>
      <view class="setting-options">
        <view class="option-btn {{fontSize === 'small' ? 'active' : ''}}" bindtap="onSetFontSize" data-size="small">标准</view>
        <view class="option-btn {{fontSize === 'medium' ? 'active' : ''}}" bindtap="onSetFontSize" data-size="medium">大</view>
        <view class="option-btn {{fontSize === 'large' ? 'active' : ''}}" bindtap="onSetFontSize" data-size="large">超大</view>
      </view>
    </view>
  </view>

  <view class="section-title">其他</view>
  <view class="section">
    <view class="setting-item" bindtap="onClearCache">
      <text class="setting-label">缓存清理</text>
      <text class="setting-value">{{cacheSize}}</text>
    </view>
    <view class="setting-item" bindtap="onAbout">
      <text class="setting-label">关于我们</text>
      <text class="setting-arrow">›</text>
    </view>
  </view>
</view>
