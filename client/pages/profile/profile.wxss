.page {
  min-height: 100vh;
  background: #FDF5E6;
  padding-bottom: 40rpx;
}
.header {
  background: linear-gradient(135deg, #5D4037, #D4A84B);
  padding: 60rpx 40rpx 40rpx;
  text-align: center;
}
.avatar-wrap {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  margin: 0 auto 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #FDF5E6;
}
.avatar {
  font-size: 72rpx;
}
.user-info {
  margin-bottom: 24rpx;
}
.nickname {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
}
.level-tag {
  display: inline-block;
  background: #D4A84B;
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 20rpx;
  border-radius: 20rpx;
}
.balance-card {
  background: rgba(255,255,255,0.15);
  border-radius: 16rpx;
  padding: 16rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.balance-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}
.balance-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}
.stats-grid {
  display: flex;
  margin: 30rpx 30rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.stat-item {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid #f0e8d8;
}
.stat-item:last-child { border-right: none; }
.stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #D4A84B;
}
.stat-label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}
.menu-list {
  margin: 0 30rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #f5efe5;
}
.menu-item:last-child { border-bottom: none; }
.menu-icon { font-size: 36rpx; margin-right: 20rpx; }
.menu-text { flex: 1; font-size: 28rpx; color: #5D4037; }
.menu-arrow { font-size: 36rpx; color: #ccc; }
.logout-btn {
  margin: 60rpx 80rpx 0;
  padding: 24rpx;
  text-align: center;
  border: 2rpx solid #C0392B;
  border-radius: 12rpx;
  color: #C0392B;
  font-size: 28rpx;
}
