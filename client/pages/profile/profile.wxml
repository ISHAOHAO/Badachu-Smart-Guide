<view class="page">
  <view class="header">
    <view class="avatar-wrap">
      <view class="avatar">🧑</view>
    </view>
    <view class="user-info">
      <view class="nickname">{{nickname}}</view>
      <view class="level-tag">{{levelName}}</view>
    </view>
    <view class="balance-card">
      <text class="balance-label">福光余额</text>
      <text class="balance-value">{{fuguang}} ✨</text>
    </view>
  </view>

  <view class="stats-grid">
    <view class="stat-item">
      <text class="stat-num">{{stats.checkins}}</text>
      <text class="stat-label">打卡景点</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{stats.badges}}</text>
      <text class="stat-label">获得徽章</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{stats.hidden}}</text>
      <text class="stat-label">发现隐藏</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{stats.quiz}}</text>
      <text class="stat-label">答题正确</text>
    </view>
  </view>

  <view class="menu-list">
    <view class="menu-item" bindtap="goBadges">
      <text class="menu-icon">🏅</text>
      <text class="menu-text">徽章墙</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goRecords">
      <text class="menu-icon">📜</text>
      <text class="menu-text">游览记录</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goFavorites">
      <text class="menu-icon">⭐</text>
      <text class="menu-text">收藏内容</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goPractice">
      <text class="menu-icon">🧘</text>
      <text class="menu-text">修行记录</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goSettings">
      <text class="menu-icon">⚙️</text>
      <text class="menu-text">设置</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="logout-btn" bindtap="onLogout">退出登录</view>
</view>
