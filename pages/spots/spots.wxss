.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.page-header {
  padding: 40rpx 32rpx 24rpx;
  text-align: center;
}

.page-title {
  display: block;
  font-size: var(--font-xxl);
  font-weight: 700;
  color: var(--color-brown);
  margin-bottom: 8rpx;
}

.page-subtitle {
  display: block;
  font-size: var(--font-md);
  color: var(--color-gold);
}

.overview-card {
  margin: 0 32rpx 24rpx;
  background: linear-gradient(135deg, var(--color-brown), var(--color-brown-light));
  border-radius: var(--radius-lg);
  padding: 32rpx;
}

.overview-title {
  display: block;
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-gold-light);
  margin-bottom: 12rpx;
}

.overview-text {
  display: block;
  font-size: var(--font-sm);
  color: rgba(255,255,255,0.8);
  margin-bottom: 4rpx;
}

.spots-list {
  padding: 0 32rpx;
}

.spot-item {
  display: flex;
  align-items: flex-start;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
}

.spot-rank {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, var(--color-gold), var(--color-gold-dark));
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-xs);
  color: var(--color-white);
  font-weight: 600;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.spot-content {
  flex: 1;
}

.spot-name {
  display: block;
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.spot-subtitle {
  display: block;
  font-size: var(--font-sm);
  color: var(--color-gold);
  margin-bottom: 8rpx;
}

.spot-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.spot-tag {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  background: var(--color-gray-5);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
}

.spot-desc {
  display: block;
  font-size: var(--font-sm);
  color: var(--text-secondary);
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.spot-arrow {
  font-size: 36rpx;
  color: var(--color-gray-4);
  margin-left: 16rpx;
  margin-top: 16rpx;
}