.page { padding: 20rpx; background: #FDF5E6; min-height: 100vh; }
.header { text-align: center; padding: 30rpx 0 10rpx; }
.title { font-size: 38rpx; font-weight: bold; color: #5D4037; }
.subtitle { font-size: 24rpx; color: #8B7355; display: block; margin-top: 6rpx; }

.wheel-container { position: relative; width: 550rpx; height: 550rpx; margin: 20rpx auto; }
.wheel { width: 100%; height: 100%; border-radius: 50%; position: relative; overflow: hidden; border: 8rpx solid #D4A84B; box-shadow: 0 0 30rpx rgba(212,168,75,0.3); }
.wheel-segment { position: absolute; width: 50%; height: 50%; transform-origin: 100% 100%; left: 0; top: 0; }
.wheel-segment::after { content: ''; position: absolute; width: 100%; height: 100%; background: inherit; transform: skewY(-30deg); transform-origin: 100% 100%; }
.wheel-label { position: absolute; left: 50%; top: 30%; font-size: 20rpx; color: #fff; font-weight: bold; transform-origin: center; white-space: nowrap; text-shadow: 0 1rpx 2rpx rgba(0,0,0,0.5); }
.wheel-pointer { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 80rpx; height: 80rpx; background: #C0392B; border-radius: 50%; text-align: center; line-height: 80rpx; font-size: 40rpx; z-index: 10; box-shadow: 0 4rpx 12rpx rgba(192,57,43,0.5); }

.info-row { flex-direction: row; justify-content: space-around; display: flex; background: #fff; border-radius: 16rpx; padding: 24rpx; margin: 20rpx 0; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05); }
.info-item { text-align: center; }
.info-label { font-size: 22rpx; color: #8B7355; display: block; }
.info-value { font-size: 32rpx; font-weight: bold; color: #5D4037; margin-top: 6rpx; display: block; }
.info-value.gold { color: #D4A84B; }

.section-title { font-size: 32rpx; font-weight: bold; color: #5D4037; margin: 30rpx 0 20rpx; padding-left: 10rpx; border-left: 6rpx solid #D4A84B; }
.pool-list { background: #fff; border-radius: 16rpx; overflow: hidden; }
.pool-item { flex-direction: row; justify-content: space-between; align-items: center; display: flex; padding: 20rpx 24rpx; border-bottom: 1rpx solid #f0e8d8; }
.pool-item:last-child { border-bottom: none; }
.pool-left { flex-direction: row; align-items: center; display: flex; }
.pool-dot { width: 20rpx; height: 20rpx; border-radius: 50%; margin-right: 14rpx; }
.pool-name { font-size: 28rpx; color: #5D4037; }
.pool-rate { font-size: 26rpx; color: #D4A84B; font-weight: bold; }
