.page { padding: 20rpx; background: #FDF5E6; min-height: 100vh; }
.header { text-align: center; padding: 30rpx 0 20rpx; }
.title { font-size: 40rpx; font-weight: bold; color: #5D4037; }
.subtitle { font-size: 26rpx; color: #8B7355; display: block; margin-top: 8rpx; }
.card { background: linear-gradient(135deg, #D4A84B, #C0392B); border-radius: 20rpx; padding: 30rpx; margin: 20rpx 0; color: #fff; }
.card-header { flex-direction: row; justify-content: space-between; align-items: center; display: flex; }
.card-title { font-size: 28rpx; opacity: 0.9; }
.card-badge { background: rgba(255,255,255,0.25); padding: 6rpx 18rpx; border-radius: 20rpx; font-size: 22rpx; }
.card-amount { font-size: 64rpx; font-weight: bold; margin: 20rpx 0; }
.level-bar { flex-direction: row; align-items: center; display: flex; margin: 10rpx 0; }
.level-bar-bg { flex: 1; height: 12rpx; background: rgba(255,255,255,0.3); border-radius: 6rpx; overflow: hidden; }
.level-bar-fill { height: 100%; background: #fff; border-radius: 6rpx; }
.level-text { font-size: 22rpx; margin-left: 12rpx; min-width: 50rpx; }
.level-info { flex-direction: row; justify-content: space-between; display: flex; font-size: 20rpx; opacity: 0.8; margin-top: 6rpx; }
.grid { display: flex; flex-wrap: wrap; margin: 20rpx 0; gap: 16rpx; }
.grid-item { width: calc(50% - 8rpx); background: #fff; border-radius: 16rpx; padding: 30rpx 0; text-align: center; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.grid-icon { font-size: 48rpx; display: block; }
.grid-label { font-size: 28rpx; color: #5D4037; margin-top: 12rpx; display: block; }
.section-title { font-size: 32rpx; font-weight: bold; color: #5D4037; margin: 30rpx 0 20rpx; padding-left: 10rpx; border-left: 6rpx solid #D4A84B; }
.task-list { background: #fff; border-radius: 16rpx; overflow: hidden; }
.task-item { flex-direction: row; justify-content: space-between; align-items: center; display: flex; padding: 26rpx 24rpx; border-bottom: 1rpx solid #f0e8d8; }
.task-item:last-child { border-bottom: none; }
.task-left { flex-direction: row; align-items: center; display: flex; flex: 1; }
.task-check { width: 36rpx; height: 36rpx; border-radius: 50%; border: 2rpx solid #D4A84B; margin-right: 16rpx; flex-shrink: 0; text-align: center; line-height: 36rpx; font-size: 22rpx; color: #D4A84B; }
.task-check.checked { background: #D4A84B; color: #fff; border-color: #D4A84B; }
.task-name { font-size: 28rpx; color: #5D4037; }
.task-item.done .task-name { color: #aaa; text-decoration: line-through; }
.task-points { font-size: 24rpx; color: #D4A84B; font-weight: bold; }
