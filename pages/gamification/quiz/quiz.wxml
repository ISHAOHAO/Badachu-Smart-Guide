<view class="page">
  <view class="header">
    <text class="title">📝 文化问答</text>
    <text class="subtitle">考验你的佛教文化与八大处知识</text>
  </view>

  <block wx:if="{{!started}}">
    <view class="stats-card">
      <text class="stats-title">今日战绩</text>
      <view class="stats-row">
        <view class="stat-item">
          <text class="stat-num green">{{stats.correct}}</text>
          <text class="stat-label">答对</text>
        </view>
        <view class="stat-item">
          <text class="stat-num red">{{stats.wrong}}</text>
          <text class="stat-label">答错</text>
        </view>
        <view class="stat-item">
          <text class="stat-num gold">{{stats.fuguang}}</text>
          <text class="stat-label">获得福光</text>
        </view>
      </view>
    </view>
    <view class="start-btn" bindtap="onStart">开始答题</view>
  </block>

  <block wx:if="{{started}}">
    <view class="quiz-header">
      <text class="quiz-progress">第{{current+1}}/{{questions.length}}题</text>
      <view class="quiz-progress-bar">
        <view class="quiz-progress-fill" style="width: {{((current+1)/questions.length)*100}}%"></view>
      </view>
    </view>

    <view class="tag">{{questions[current].category}}</view>
    <view class="question">{{questions[current].question}}</view>

    <view class="options">
      <view class="option {{optionClass(index)}}" wx:for="{{questions[current].options}}" wx:for-item="opt" wx:key="index" data-index="{{index}}" bindtap="onSelect">
        <text class="option-letter">{{optLabel(index)}}</text>
        <text class="option-text">{{opt}}</text>
      </view>
    </view>

    <view wx:if="{{selected !== null}}" class="feedback">
      <text class="feedback-icon {{selected === questions[current].answer ? 'correct' : 'wrong'}}">{{selected === questions[current].answer ? '✓ 回答正确！' : '✗ 回答错误'}}</text>
      <text class="feedback-desc">{{questions[current].explanation}}</text>
      <view class="next-btn" bindtap="onNext">{{current < questions.length - 1 ? '下一题' : '查看结果'}}</view>
    </view>
  </block>

  <view wx:if="{{finished}}" class="result">
    <text class="result-title">答题完成</text>
    <text class="result-score">答对 {{correctCount}} / {{questions.length}}</text>
    <text class="result-points">获得 {{earnedPoints}} 福光</text>
    <view class="result-btn" bindtap="onRestart">再来一次</view>
    <view class="result-btn secondary" bindtap="onBack">返回</view>
  </view>
</view>
