.page {
  background: #FDF5E6;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.top-section {
  display: flex;
  justify-content: center;
  padding: 60rpx 0 30rpx;
}

.zen-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #D4A84B, #C0392B);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.zen-icon image {
  width: 80rpx;
  height: 80rpx;
  position: relative;
  z-index: 2;
}

.zen-icon.pulse {
  animation: glow 1.5s ease-in-out infinite;
}

@keyframes glow {
  0%, 100% { box-shadow: 0 0 20rpx rgba(212,168,75,0.4); }
  50% { box-shadow: 0 0 60rpx rgba(212,168,75,0.8), 0 0 100rpx rgba(192,57,43,0.3); }
}

.ripple {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 4rpx solid rgba(212,168,75,0.4);
  animation: rippleAnim 2s ease-out infinite;
}

.ripple-2 { animation-delay: 0.6s; }
.ripple-3 { animation-delay: 1.2s; }

@keyframes rippleAnim {
  0% { transform: scale(1); opacity: 0.6; }
  100% { transform: scale(1.8); opacity: 0; }
}

.status-card {
  margin: 0 30rpx 24rpx;
  padding: 24rpx 30rpx;
  background: #FFF;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(93,64,55,0.08);
}

.status-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.status-row + .status-row {
  border-top: 2rpx solid #F5E6D0;
}

.status-label {
  font-size: 28rpx;
  color: #8B7355;
}

.status-value {
  font-size: 28rpx;
  color: #8B7355;
}

.status-value.active {
  color: #D4A84B;
  font-weight: 500;
}

.signal-bars {
  display: flex;
  gap: 6rpx;
  align-items: flex-end;
}

.bar {
  width: 12rpx;
  height: 16rpx;
  background: #E0D5C5;
  border-radius: 4rpx;
}

.bar:nth-child(2) { height: 24rpx; }
.bar:nth-child(3) { height: 32rpx; }
.bar:nth-child(4) { height: 40rpx; }

.bar.active {
  background: linear-gradient(to top, #D4A84B, #C0392B);
}

.status-hint {
  font-size: 26rpx;
  color: #5D4037;
}

.explore-btn {
  margin: 0 30rpx 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  color: #FFF;
}

.explore-btn.start {
  background: linear-gradient(135deg, #D4A84B, #C0392B);
}

.explore-btn.stop {
  background: #5D4037;
}

.section {
  margin: 0 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #5D4037;
}

.section-count {
  font-size: 26rpx;
  color: #D4A84B;
  font-weight: 500;
}

.hidden-spot-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.hidden-spot-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 24rpx;
  background: #FFF;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(93,64,55,0.08);
}

.hidden-spot-item.found {
  background: linear-gradient(135deg, #FDF5E6, #F5E6D0);
  border: 2rpx solid #D4A84B;
}

.spot-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.spot-type-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  background: #F5E6D0;
  color: #5D4037;
  border-radius: 20rpx;
  align-self: flex-start;
}

.spot-name {
  font-size: 28rpx;
  color: #5D4037;
  font-weight: 500;
}

.spot-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.spot-status-text {
  font-size: 24rpx;
  color: #D4A84B;
}

.spot-signal {
  font-size: 22rpx;
  color: #8B7355;
}

.spot-blessing {
  font-size: 22rpx;
  color: #C0392B;
  font-weight: 500;
}

.arrow {
  width: 28rpx;
  height: 28rpx;
}
