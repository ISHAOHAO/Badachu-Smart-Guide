<view class="page">
  <view class="hero">
    <view class="hero-bg">
      <text class="hero-icon">{{spot.icon}}</text>
    </view>
    <view class="hero-content">
      <text class="hero-order">{{spot.templeOrder}}</text>
      <text class="hero-name">{{spot.name}}</text>
      <text class="hero-subtitle">{{spot.subtitle}}</text>
    </view>
  </view>

  <view class="info-bar">
    <view class="info-item">
      <text class="info-label">始建</text>
      <text class="info-value">{{spot.founded}}</text>
    </view>
    <view class="info-divider"></view>
    <view class="info-item">
      <text class="info-label">游览时长</text>
      <text class="info-value">{{spot.visitDuration}}</text>
    </view>
    <view class="info-divider"></view>
    <view class="info-item">
      <text class="info-label">开放时间</text>
      <text class="info-value">{{spot.openingHours}}</text>
    </view>
  </view>

  <view class="section">
    <text class="section-title">景点简介</text>
    <text class="section-text">{{spot.description}}</text>
  </view>

  <view class="section">
    <text class="section-title">历史渊源</text>
    <text class="section-text">{{spot.history}}</text>
  </view>

  <view class="section">
    <text class="section-title">佛教文化</text>
    <text class="section-text">{{spot.culture}}</text>
  </view>

  <view class="section">
    <text class="section-title">景点亮点</text>
    <view class="highlights">
      <view class="highlight-item" wx:for="{{spot.highlights}}" wx:key="*this">
        <text class="highlight-dot">•</text>
        <text class="highlight-text">{{item}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <text class="section-title">语音讲解</text>
    <view class="audio-player">
      <view class="audio-btn" bindtap="playAudio">
        <text class="audio-icon">{{isPlaying ? '⏸️' : '▶️'}}</text>
        <text class="audio-text">{{isPlaying ? '暂停播放' : '点击播放语音讲解'}}</text>
      </view>
      <view class="audio-progress" wx:if="{{isPlaying}}">
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{audioProgress}}%"></view>
        </view>
      </view>
    </view>
  </view>

  <view class="action-bar">
    <view class="action-btn primary" bindtap="goCheckin">
      <text>📍 到此打卡</text>
    </view>
    <view class="action-btn secondary" bindtap="goNavigate">
      <text>🧭 导航前往</text>
    </view>
  </view>
</view>