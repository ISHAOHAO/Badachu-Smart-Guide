.page {
  padding-bottom: 140rpx;
}

.hero {
  position: relative;
  height: 350rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, var(--color-brown-dark), var(--color-brown), var(--color-gold-dark));
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-icon {
  font-size: 120rpx;
  opacity: 0.15;
}

.hero-content {
  position: relative;
  text-align: center;
  z-index: 1;
}

.hero-order {
  display: block;
  font-size: var(--font-md);
  color: var(--color-gold-light);
  margin-bottom: 8rpx;
}

.hero-name {
  display: block;
  font-size: var(--font-title);
  font-weight: 700;
  color: var(--color-white);
  margin-bottom: 8rpx;
}

.hero-subtitle {
  display: block;
  font-size: var(--font-base);
  color: rgba(255,255,255,0.7);
}

.info-bar {
  display: flex;
  background: var(--bg-card);
  margin: -40rpx 32rpx 24rpx;
  border-radius: var(--radius-lg);
  padding: 24rpx 16rpx;
  box-shadow: var(--shadow-md);
  position: relative;
  z-index: 2;
}

.info-item {
  flex: 1;
  text-align: center;
}

.info-label {
  display: block;
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  margin-bottom: 4rpx;
}

.info-value {
  display: block;
  font-size: var(--font-xs);
  color: var(--text-primary);
  font-weight: 500;
}

.info-divider {
  width: 2rpx;
  background: var(--color-gray-5);
  margin: 8rpx 0;
}

.section {
  padding: 0 32rpx;
  margin-bottom: 32rpx;
}

.section-title {
  display: block;
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-brown);
  margin-bottom: 16rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid var(--color-gold);
}

.section-text {
  display: block;
  font-size: var(--font-base);
  color: var(--text-secondary);
  line-height: 1.8;
}

.highlights {
  padding: 0 16rpx;
}

.highlight-item {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.highlight-dot {
  color: var(--color-gold);
  font-size: var(--font-lg);
  margin-right: 12rpx;
}

.highlight-text {
  font-size: var(--font-base);
  color: var(--text-secondary);
}

.audio-player {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  box-shadow: var(--shadow-sm);
}

.audio-btn {
  display: flex;
  align-items: center;
}

.audio-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.audio-text {
  font-size: var(--font-base);
  color: var(--text-secondary);
}

.audio-progress {
  margin-top: 16rpx;
}

.progress-bar {
  height: 6rpx;
  background: var(--color-gray-5);
  border-radius: 3rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--color-gold);
  border-radius: 3rpx;
  transition: width 0.3s;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: var(--bg-card);
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.08);
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: var(--radius-md);
  font-size: var(--font-base);
  font-weight: 600;
}

.action-btn.primary {
  background: linear-gradient(135deg, var(--color-gold), var(--color-gold-dark));
  color: var(--color-white);
}

.action-btn.secondary {
  background: var(--color-gray-5);
  color: var(--text-primary);
}