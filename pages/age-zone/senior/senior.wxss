.page {
  min-height: 100vh;
  background: #FDF5E6;
  padding: 30rpx;
  font-size: 1.3em;
}
.page-title {
  font-size: 52rpx;
  font-weight: bold;
  color: #5D4037;
  text-align: center;
  margin-bottom: 12rpx;
}
.page-subtitle {
  text-align: center;
  font-size: 30rpx;
  color: #999;
  margin-bottom: 30rpx;
}
.section-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #5D4037;
  margin-bottom: 20rpx;
  margin-top: 16rpx;
  padding-left: 12rpx;
  border-left: 8rpx solid #D4A84B;
}
.health-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  border: 2rpx solid #e8ddd0;
}
.health-icon { font-size: 64rpx; margin-right: 24rpx; }
.health-info { flex: 1; }
.health-title { font-size: 34rpx; font-weight: bold; color: #5D4037; display: block; }
.health-desc { font-size: 28rpx; color: #999; display: block; margin-top: 8rpx; }
.chant-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.chant-icon { font-size: 56rpx; margin-right: 24rpx; }
.chant-info { flex: 1; }
.chant-name { font-size: 34rpx; font-weight: bold; color: #5D4037; display: block; }
.chant-length { font-size: 26rpx; color: #bbb; display: block; margin-top: 6rpx; }
.chant-play { font-size: 44rpx; color: #D4A84B; }
.voice-area {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}
.voice-btn {
  flex: 1;
  padding: 36rpx 20rpx;
  border-radius: 24rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.voice-big { background: #D4A84B; color: #fff; }
.voice-nav { background: #5D4037; color: #fff; }
.zen-card {
  background: linear-gradient(135deg, #5D4037, #D4A84B);
  border-radius: 24rpx;
  padding: 40rpx;
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(93,64,55,0.3);
}
.zen-content { flex: 1; }
.zen-title { font-size: 40rpx; font-weight: bold; color: #fff; display: block; }
.zen-desc { font-size: 28rpx; color: rgba(255,255,255,0.8); display: block; margin-top: 10rpx; }
.zen-hint { font-size: 30rpx; color: #FDF5E6; display: block; margin-top: 16rpx; }
.zen-icon { font-size: 80rpx; margin-left: 20rpx; }
