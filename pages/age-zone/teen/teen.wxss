.page {
  min-height: 100vh;
  background: linear-gradient(135deg, #0d0d2b 0%, #1a1a3e 30%, #2d1b4e 60%, #5D4037 100%);
  padding: 30rpx;
  color: #fff;
}
.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #D4A84B;
  text-align: center;
}
.page-subtitle {
  text-align: center;
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
  margin-bottom: 30rpx;
}
.grid-2col {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}
.card {
  flex: 1;
  background: rgba(255,255,255,0.08);
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(212,168,75,0.3);
  border-radius: 24rpx;
  padding: 40rpx 20rpx;
  text-align: center;
}
.card-icon { font-size: 64rpx; margin-bottom: 12rpx; }
.card-title { font-size: 28rpx; font-weight: bold; color: #D4A84B; display: block; }
.card-desc { font-size: 20rpx; color: rgba(255,255,255,0.5); display: block; margin-top: 6rpx; }
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #D4A84B;
  margin-bottom: 16rpx;
  margin-top: 10rpx;
}
.meditation-card {
  background: rgba(255,255,255,0.08);
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(212,168,75,0.3);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 30rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}
.meditation-icon {
  font-size: 56rpx;
  margin-right: 20rpx;
}
.meditation-info {
  flex: 1;
}
.meditation-time {
  font-size: 40rpx;
  font-weight: bold;
  color: #D4A84B;
  display: block;
}
.meditation-label {
  font-size: 20rpx;
  color: rgba(255,255,255,0.5);
  display: block;
}
.meditation-controls {
  width: 100%;
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}
.ctrl-btn {
  flex: 1;
  padding: 16rpx;
  text-align: center;
  border: 1rpx solid rgba(212,168,75,0.5);
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #D4A84B;
}
.ctrl-btn.active {
  background: #D4A84B;
  color: #0d0d2b;
}
.ctrl-btn.reset { border-color: rgba(255,255,255,0.3); color: rgba(255,255,255,0.6); }
.card-wide {
  background: rgba(255,255,255,0.08);
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(212,168,75,0.3);
  border-radius: 24rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}
.card-wide-icon { font-size: 52rpx; margin-right: 20rpx; }
.card-wide-info { flex: 1; }
.card-wide-title { font-size: 28rpx; font-weight: bold; color: #D4A84B; display: block; }
.card-wide-desc { font-size: 20rpx; color: rgba(255,255,255,0.5); display: block; margin-top: 4rpx; }
.card-wide-arrow { font-size: 40rpx; color: rgba(255,255,255,0.3); }
.challenge-card {
  background: rgba(255,255,255,0.08);
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(212,168,75,0.3);
  border-radius: 24rpx;
  padding: 28rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-bottom: 30rpx;
}
.challenge-text {
  width: 100%;
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
  margin-bottom: 16rpx;
  display: block;
}
.challenge-progress {
  flex: 1;
  height: 14rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 7rpx;
  overflow: hidden;
  margin-right: 16rpx;
}
.challenge-fill {
  height: 100%;
  background: linear-gradient(90deg, #D4A84B, #C0392B);
  border-radius: 7rpx;
}
.challenge-percent {
  font-size: 24rpx;
  color: #D4A84B;
}
